{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfcaresync2026"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-keyvault2026.vault.azure.net/"
		},
		"LS_DataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresynceproject.dfs.core.windows.net/"
		},
		"LS_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-falling-sunset-bifyhjk3-pooler.c-5.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_SqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server2026.database.windows.net"
		},
		"LS_SqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQL-DB-Caresync"
		},
		"LS_SqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "databeli"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1123-111238-xh600ntn"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfcaresync2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_DataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('LS_DataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_server')]"
					},
					"LS_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_database')]"
					},
					"LS_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_username')]"
					},
					"LS_SqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('LS_SqlDatabase_properties_typeProperties_server')]"
					},
					"LS_SqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('LS_SqlDatabase_properties_typeProperties_database')]"
					},
					"LS_SqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('LS_SqlDatabase_properties_typeProperties_userName')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}