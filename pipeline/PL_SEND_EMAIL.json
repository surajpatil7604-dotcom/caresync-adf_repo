{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read_all_tables_status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM ctrl.audit_log WHERE adf_run_id = ''', pipeline().parameters.adf_run_id, '''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare_email_body_header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "ingestion and transformation process for caresync project has been completed "
				}
			},
			{
				"name": "prepare_email_body_footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "for any fail or any status if you want please reach out my Toper Manger Himani\ndhumal.himani@gmail.com "
				}
			},
			{
				"name": "prepaer_email_subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "check_overall_failed_count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env}|@{if(greater(activity('check_overall_failed_count').output.firstRow.count,0),'FAILED','Success')}|Caresync Master Run",
						"type": "Expression"
					}
				}
			},
			{
				"name": "check_overall_failed_count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT(*) AS count\nFROM ctrl.audit_log\nWHERE adf_run_id = 'd0f79f12-1234-4567-8901-123456789abc'\nAND status <> 'Success'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "prepaer_logic_apps_body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Read_all_tables_status",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_body_header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_body_footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepaer_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\"@{variables('email_subject')}\"\",\n\"email_receipent\":\"@{pipeline().globalParameters.email_receipent}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body_footer\":\"@{variables('body_footer')}\",\n\"status_table\":activity('Read_all_tables_status').output.value\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "61d0f79f-ee0f-4d17-a267-a8a10e45edf6"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}